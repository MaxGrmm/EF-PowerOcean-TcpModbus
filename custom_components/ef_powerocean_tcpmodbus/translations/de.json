    },
    "control_test_running": {
      "message": "Auf diesem Wechselrichter läuft bereits ein Steuerungstest."
    },
    "control_test_no_data": {
      "message": "Der Wechselrichter ist nicht verbunden oder wurde noch nicht gelesen. Es wurde nichts geschrieben."
    },
    "control_test_no_status": {
      "message": "Der Systemstatus (40530) ist nicht lesbar oder Modbus TCP scheint in der EcoFlow-App deaktiviert, daher könnte der Test nicht sehen, was der Wechselrichter tut. Es wurde nichts geschrieben."
    },
    "control_test_other_controller": {
      "message": "Der Wechselrichter meldet eine andere Modbus-Steuerung. Diese beenden, eine Minute warten und erneut versuchen. Es wurde nichts geschrieben."
