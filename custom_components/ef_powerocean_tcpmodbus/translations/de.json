  "services": {
    "set_battery_command": {
      "name": "Batteriebefehl setzen",
      "description": "Setzt den Batteriemodus, seine Leistung und die Ladegrenze in einem Schritt, auf Wunsch zeitlich begrenzt. Gedacht für Automationen und Batterieplaner.",
      "fields": {
        "device_id": {
          "name": "Wechselrichter",
          "description": "Der zu steuernde Wechselrichter."
        },
        "mode": {
          "name": "Modus",
          "description": "Der zu wählende Batteriemodus."
        },
        "power": {
          "name": "Leistung",
          "description": "Leistung für den Modus, über 0 W. Erforderlich für Batterie laden, Batterie entladen, Ins Netz einspeisen und Aus dem Netz beziehen. Optional für Solar zuerst einspeisen, wo sie die Solar-Einspeisegrenze setzt; ohne sie bleibt die aktuelle. Für die anderen nicht erlaubt. Ein Wert über dem Maximum des Wechselrichters wird darauf begrenzt."
        },
        "charge_limit_soc": {
          "name": "Ladegrenze",
          "description": "Setzt die Ladegrenze. Ohne Angabe bleibt sie, wie sie ist. Die Integration setzt sie nie von selbst zurück."
        },
        "expire_in": {
          "name": "Läuft ab in",
          "description": "Sekunden, bis der Modus zu Automatisch zurückkehrt. Erneutes Senden des Befehls startet die Zählung neu. Ohne Angabe bleibt der Modus, bis er geändert wird."
        }
      }
    },
    "run_control_test": {
      "name": "Steuerungstest ausführen",
      "description": "Prüft, welchen Steuerungsmethoden die Firmware dieses Wechselrichters folgt, wie scripts/control_feature_scan.py, und schreibt einen Bericht, der an ein GitHub-Issue angehängt werden kann. Ist die Modbus-Steuerung eingeschaltet, pausiert der gewählte Batteriemodus während des Tests und wird danach fortgesetzt. Die Batterie lädt und entlädt kurz mit der Testleistung, am Ende wird der Wechselrichter an die EcoFlow-App zurückgegeben. Dauert etwa 10 Minuten; mit Antwort wartet die Aktion auf den Bericht, sonst zeigt der Sensor Steuerungstest den Fortschritt.",
      "fields": {
        "device_id": {
          "name": "Wechselrichter",
          "description": "Der zu testende Wechselrichter."
        },
        "confirm": {
          "name": "Bestätigen",
          "description": "Muss eingeschaltet sein. Der Test schreibt Steuerbefehle und pausiert einen gewählten Batteriemodus, die Batterie lädt und entlädt, und für einige Minuten fließt Leistung ins und aus dem Netz."
        },
        "power": {
          "name": "Testleistung",
          "description": "Leistung für jede Methode, 600 bis 3000 W. Wird reduziert, wo die Einspeisebegrenzung weniger erlaubt."
        }
      }
    },
    "cancel_control_test": {
      "name": "Steuerungstest abbrechen",
      "description": "Bricht einen laufenden Steuerungstest ab. Der Wechselrichter wird auf die Standardmethode gesetzt und an die EcoFlow-App zurückgegeben.",
      "fields": {
        "device_id": {
          "name": "Wechselrichter",
          "description": "Der Wechselrichter, dessen Test abgebrochen wird."
        }
      }
    }
  },
